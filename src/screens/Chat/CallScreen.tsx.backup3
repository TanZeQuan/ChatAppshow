import React from 'react';
import { ActivityIndicator, Dimensions, Image, Modal, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
import { readUsers } from '../../api/User';
import { Emitter } from '../../services/EventEmitter';
import WebSocketManager from '../../services/WebSocketManager';
import { useContactStore } from '../../store/contactStore';

const { width, height } = Dimensions.get('window');

export default function CallScreen() {
  const getContactById = useContactStore(state => state.getContactById);
  const [modalVisible, setModalVisible] = React.useState(false);
  const [status, setStatus] = React.useState('');
  const [callerId, setCallerId] = React.useState('');
  const [isIncoming, setIsIncoming] = React.useState(false);
  const [targetUserId, setTargetUserId] = React.useState<string | null>(null);
  
  // 用户信息状态
  const [userName, setUserName] = React.useState<string>('');
  const [userAvatar, setUserAvatar] = React.useState<string>('');
  const [loadingUserInfo, setLoadingUserInfo] = React.useState(false);

  // 获取用户信息
  const fetchUserInfo = React.useCallback(async (userId: string) => {
    console.log('[CallScreen] Fetching user info for:', userId);
    setLoadingUserInfo(true);
    try {
      const result = await readUsers(userId);
      console.log('[CallScreen] API result:', result);
      if (result.success && result.data) {
        // API 返回格式：{ response: { name, image, ... } }
        const userData = result.data.response || result.data;
        console.log('[CallScreen] User data:', userData);
        setUserName(userData.name || userId);
        setUserAvatar(userData.image || '');  // 使用 image 而不是 avatar
        console.log('[CallScreen] Set userName:', userData.name, 'userAvatar:', userData.image);
      } else {
        setUserName(userId);
        setUserAvatar('');
      }
    } catch (error) {
      console.error('[CallScreen] Error fetching user info:', error);
      setUserName(userId);
      setUserAvatar('');
    } finally {
      setLoadingUserInfo(false);
    }
  }, []);

  React.useEffect(() => {
    const handleIncomingCall = (incomingCallerId: string) => {
      setCallerId(incomingCallerId);
      setTargetUserId(incomingCallerId);
      setIsIncoming(true);
      setModalVisible(true);
      // 获取来电者信息
      fetchUserInfo(incomingCallerId);
    };

    const handleCallStatus = (newStatus: string) => {
      setStatus(newStatus);
    };

    const handleStartCall = (targetId: string) => {
      setTargetUserId(targetId);
      setIsIncoming(false);
      setModalVisible(true);
      // 获取被叫者信息
      fetchUserInfo(targetId);
    };
    
    const handleEndCall = () => {
      setModalVisible(false);
      setStatus('');
      setCallerId('');
      setIsIncoming(false);
      setUserName('');
      setUserAvatar('');
    };

    Emitter.on('incomingCall', handleIncomingCall);
    Emitter.on('callStatus', handleCallStatus);
    Emitter.on('startCall', handleStartCall);
    Emitter.on('endCall', handleEndCall);

    return () => {
      Emitter.off('incomingCall', handleIncomingCall);
      Emitter.off('callStatus', handleCallStatus);
      Emitter.off('startCall', handleStartCall);
      Emitter.off('endCall', handleEndCall);
    };
  }, [fetchUserInfo]);

  const answer = () => {
    WebSocketManager.callService?.answerCall();
    setIsIncoming(false);
  };

  const reject = () => {
    WebSocketManager.callService?.rejectCall();
    setModalVisible(false);
  };

  const hangup = () => {
    WebSocketManager.callService?.cleanup();
    setModalVisible(false);
  };

  // 翻译状态文本
  const translateStatus = (status: string) => {
    const statusMap: { [key: string]: string } = {
      'Calling...': '等待接听...',
      'Ringing...': '响铃中...',
      'Connected': '通话中',
      'Connecting...': '连接中...',
      'Ended': '通话结束',
      'Rejected': '对方已拒绝',
      'Busy': '对方忙碌中',
      'No Answer': '无人接听',
    };
    return statusMap[status] || status;
  };

  // 优先使用 API 获取的信息，否则尝试从 contactStore，最后使用 userId
  const contact = targetUserId ? getContactById(targetUserId) : null;
  const displayName = userName || contact?.name || targetUserId || '未知用户';
  const displayAvatar = userAvatar || contact?.avatar;

  return (
    <Modal visible={modalVisible} animationType="slide" transparent={false}>
      <View style={styles.container}>
        {/* 顶部用户信息区域 */}
        <View style={styles.topSection}>
          {/* 用户头像 */}
          {loadingUserInfo ? (
            <View style={styles.avatar}>
              <ActivityIndicator size="large" color="#FFFFFF" />
            </View>
          ) : displayAvatar ? (
            <Image 
              source={{ uri: displayAvatar }} 
              style={styles.avatarImage}
            />
          ) : (
            <View style={styles.avatar}>
              <Text style={styles.avatarText}>{displayName.charAt(0).toUpperCase()}</Text>
            </View>
          )}
          
          {/* 用户名 */}
          <Text style={styles.username}>{displayName}</Text>
          
          {/* 状态文本 */}
          <Text style={styles.statusText}>
            {isIncoming ? '邀请你语音通话...' : translateStatus(status) || '等待接听...'}
          </Text>
        </View>

        {/* 底部按钮区域 */}
        <View style={styles.bottomSection}>
          {isIncoming ? (
            <View style={styles.incomingButtons}>
              {/* 拒接按钮 */}
              <TouchableOpacity style={styles.rejectButton} onPress={reject}>
                <View style={styles.buttonCircle}>
                  <Text style={styles.buttonIcon}>✕</Text>
                </View>
                <Text style={styles.buttonLabel}>拒接</Text>
              </TouchableOpacity>

              {/* 接听按钮 */}
              <TouchableOpacity style={styles.answerButton} onPress={answer}>
                <View style={[styles.buttonCircle, styles.answerCircle]}>
                  <Text style={styles.buttonIcon}>✓</Text>
                </View>
                <Text style={styles.buttonLabel}>接听</Text>
              </TouchableOpacity>
            </View>
          ) : (
            <View style={styles.outgoingButtons}>
              {/* 挂断按钮 */}
              <TouchableOpacity style={styles.hangupButton} onPress={hangup}>
                <View style={[styles.buttonCircle, styles.hangupCircle]}>
                  <Text style={styles.buttonIcon}>✕</Text>
                </View>
                <Text style={styles.buttonLabel}>挂断</Text>
              </TouchableOpacity>
            </View>
          )}
        </View>
      </View>
    </Modal>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#2C2C2C',
  },
  
  // 顶部区域
  topSection: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    paddingTop: 100,
  },
  
  // 头像（占位符）
  avatar: {
    width: 120,
    height: 120,
    borderRadius: 60,
    backgroundColor: '#4A4A4A',
    justifyContent: 'center',
    alignItems: 'center',
    marginBottom: 20,
  },
  
  // 真实头像
  avatarImage: {
    width: 120,
    height: 120,
    borderRadius: 60,
    marginBottom: 20,
    backgroundColor: '#4A4A4A',
  },
  
  avatarText: {
    fontSize: 40,
    color: '#FFFFFF',
    fontWeight: '500',
  },
  
  // 用户名
  username: {
    fontSize: 28,
    color: '#FFFFFF',
    fontWeight: '500',
    marginBottom: 12,
  },
  
  // 状态文本
  statusText: {
    fontSize: 16,
    color: '#AAAAAA',
    marginTop: 8,
  },
  
  // 底部按钮区域
  bottomSection: {
    paddingBottom: 60,
    alignItems: 'center',
  },
  
  // 来电按钮容器
  incomingButtons: {
    flexDirection: 'row',
    justifyContent: 'space-around',
    width: width * 0.8,
  },
  
  // 拨出按钮容器
  outgoingButtons: {
    alignItems: 'center',
  },
  
  // 按钮圆圈
  buttonCircle: {
    width: 60,
    height: 60,
    borderRadius: 30,
    backgroundColor: '#E74C3C',
    justifyContent: 'center',
    alignItems: 'center',
    marginBottom: 8,
  },
  
  // 接听按钮圆圈
  answerCircle: {
    backgroundColor: '#07C160',
  },
  
  // 挂断按钮圆圈
  hangupCircle: {
    backgroundColor: '#E74C3C',
  },
  
  // 按钮图标
  buttonIcon: {
    fontSize: 32,
    color: '#FFFFFF',
    fontWeight: 'bold',
  },
  
  // 按钮标签
  buttonLabel: {
    fontSize: 14,
    color: '#FFFFFF',
    marginTop: 4,
  },
  
  // 按钮容器
  rejectButton: {
    alignItems: 'center',
  },
  answerButton: {
    alignItems: 'center',
  },
  hangupButton: {
    alignItems: 'center',
  },
});